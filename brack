#!/usr/bin/env python3
"""Shim that delegates to the `brack` Python package.

Works whether the package is installed (via `pip install .`) or simply
cloned. In the clone case we add `src/` to ``sys.path`` so the import
succeeds without installation.
"""

from __future__ import annotations

import os
import sys
from pathlib import Path

_HERE = Path(__file__).resolve().parent
_SRC = _HERE / "src"
if _SRC.exists() and str(_SRC) not in sys.path:
    sys.path.insert(0, str(_SRC))

from brack.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
